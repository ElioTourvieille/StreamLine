# ── Server ─────────────────────────────────────────────────────────────────
PORT=3001

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ── DynamoDB ────────────────────────────────────────────────────────────────
AWS_REGION=eu-central-2
# For local dev with DynamoDB Local (docker): uncomment the line below
# DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMO_TABLE=streamline

# ── S3 (deliverable file uploads) ────────────────────────────────────────────
# Pick a globally-unique name, then run: pnpm s3:setup
S3_BUCKET=

# ── AWS credentials ───────────────────────────────────────────────────────────
# Not needed if the API runs with an IAM role attached (EC2/Elastic Beanstalk/Lambda)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Web ─────────────────────────────────────────────────────────────────────
WEB_URL=http://localhost:3000

# ── Email (Resend) ─ leave empty in dev, emails are logged to console ───────
# Get your key at https://resend.com → API Keys
RESEND_API_KEY=
EMAIL_DOMAIN=origin-studio.ch
STUDIO_NOTIFY_EMAIL=
