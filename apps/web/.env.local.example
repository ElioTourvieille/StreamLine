# URL de l'API NestJS (Next.js préfixe NEXT_PUBLIC_ pour l'exposer au navigateur)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Anthropic — server-side only, never expose with NEXT_PUBLIC_
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Resend — used by the AI Generator's "Send to Client" proposal email
RESEND_API_KEY=
EMAIL_DOMAIN=origin-studio.ch

# Sentry — leave empty in dev, monitoring stays off
# Get your DSN at https://sentry.io → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps at build time (CI/prod) — safe to leave empty locally
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
